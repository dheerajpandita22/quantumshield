# QuantumShield — Environment Variables Template
# Copy this file to .env and configure for your local environment.
# Never commit real credentials or .env files to version control.

# Application
APP_NAME=QuantumShield API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://quantumshield:changeme@localhost:5432/quantumshield

# Redis (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Quantum Engine
QUANTUM_BACKEND=aer_simulator
QUANTUM_SHOTS=1024
QUANTUM_MAX_QUBITS=32

# Security (Change in production)
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_SECRET_KEY_FOR_LOCAL_DEV_ONLY
